APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Identitas sekolah (aplikasi ini dipakai di banyak sekolah)
SCHOOL_NAME="Nama Sekolah"
SCHOOL_SHORT_NAME="Sekolah"
SCHOOL_TAGLINE="Sistem Informasi Sekolah"
# Path logo relatif terhadap folder public, mis. images/logo.png (kosong = tampilkan inisial)
SCHOOL_LOGO=
# Warna utama tema, mis. #4F46E5 (kosong = warna bawaan)
SCHOOL_TEMA_WARNA=navy

# --- Tahap 3: API E-Learning (Passport) ---
# Kunci OAuth dibuat dengan `php artisan passport:keys` (file storage/oauth-*.key). Di server tanpa akses file, isi dua variabel ini dengan isi kuncinya.
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=
# Webhook ke E-Learning dikirim lewat antrian: jalankan `php artisan queue:work --tries=6` di server.

# --- Tahap 3: halaman produk & pendaftaran sekolah mandiri ---
# Isi SEKOLAH_DOMAIN_UTAMA (mis. siakad.id) agar "/" di domain utama menampilkan halaman produk dan sekolah mendapat alamat subdomain.
# Di lokal, halaman produk ada di /produk dan pendaftaran di /daftar. Trial, nama produk, dan kontak diatur di panel platform > Pengaturan Platform.
# Email verifikasi memakai MAIL_* di atas dan dikirim lewat antrian (jalankan queue:work atau schedule:run).

# --- Tahap 3 poin 4: pembayaran sewa online ---
# Lebih mudah diisi lewat panel platform > Pengaturan Platform (kunci tersimpan terenkripsi). Variabel ini hanya cadangan.
# PAYMENT_DRIVER: nonaktif | midtrans | xendit | fake (fake = simulasi, hanya lokal)
PAYMENT_DRIVER=nonaktif
MIDTRANS_SERVER_KEY=
MIDTRANS_SANDBOX=true
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# --- Tahap 3 poin 7: domain kustom per sekolah ---
# Tujuan DNS yang ditampilkan ke sekolah. CNAME otomatis "<subdomain>.<SEKOLAH_DOMAIN_UTAMA>" bila SEKOLAH_CNAME_TARGET kosong.
# Isi SEKOLAH_SERVER_IP agar sekolah bisa memakai A record (domain tanpa "www"). SSL diurus di server: lihat README.
SEKOLAH_CNAME_TARGET=
SEKOLAH_SERVER_IP=
